	},
	"keywords": [
		"liferay-theme"
	],
	"license": "LGPL",
	"liferayTheme": {
		"baseTheme": "styled",
		"distName": "classic-theme",
		"rubySass": false,
		"sassOptions": {
			"dartSass": true
		},
		"version": "7.1"
	},
	"main": "package.json",
	"name": "liferay-classic-theme",
	"sideEffects": [
		"*.scss",
		"*.css"
	],
	"repository": "liferay/liferay-portal",
	"scripts": {
		"build": "node-scripts build:theme",
		"checkFormat": "node-scripts format --check",
		"format": "node-scripts format",
		"generate:frontendToken": "ts-node ./src/util/generateFrontendTokenDefinition.ts"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"@types/tinycolor2": "^1.4.6",
		"postcss": "^8.5.8",
		"postcss-scss": "*",
		"sass": "^1.98.0",
		"tinycolor2": "^1.6.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0"
	},
	"version": "5.0.120"
}
